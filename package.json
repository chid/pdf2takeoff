{
  "name": "pdf2takeoff",
  "version": "0.1.0",
  "description": "Free, open-source PDF takeoff and markup tool that runs entirely in your browser. PDF in, quantities out — files never leave your machine.",
  "type": "module",
  "bin": {
    "pdf2takeoff": "bin/pdf2takeoff.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "typecheck:engine": "tsc --noEmit -p src/engine && node scripts/check-engine.mjs",
    "build": "npm run typecheck:engine && tsc --noEmit && vite build",
    "cli": "node bin/pdf2takeoff.js",
    "preview": "vite preview",
    "sample": "node scripts/make-sample.mjs",
    "soak": "node scripts/make-soak.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:council": "node --experimental-strip-types --test --test-timeout=600000 test/council/*.test.ts"
  },
  "keywords": [
    "pdf",
    "takeoff",
    "construction",
    "estimating",
    "measurement",
    "bluebeam-alternative",
    "quantity-survey"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajflow/pdf2takeoff"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "^1.0.11",
    "js-yaml": "^5.5.0",
    "onnxruntime-web": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
